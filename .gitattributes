# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.npy binary
*.pt binary
*.pth binary
*.safetensors binary
*.bin binary

